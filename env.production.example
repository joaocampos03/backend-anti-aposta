# On the server: cp env.production.example .env && chmod 600 .env
# Fill in every empty value there. Never commit the filled file.
# DATABASE_URL, TRUST_PROXY and the like are set by docker-compose.prod.yml.

# The name whose DNS A record points at the VPS. No https://, no slash.
API_DOMAIN=

# openssl rand -hex 24   (hex, because it goes inside a URL)
POSTGRES_PASSWORD=

# openssl rand -base64 32
OPEN_FINANCE_TOKEN_KEY=
# openssl rand -base64 24
OPEN_FINANCE_CLIENT_SECRET=

# The secret that pairs with the TURNSTILE_SITE_KEY the frontend uses. Outside
# Vercel only the empty line below stops the boot: delete the line and the test
# secret is used, silently.
TURNSTILE_SECRET_KEY=

# The frontend on Vercel, exactly: https, no trailing slash.
FRONTEND_ORIGIN=https://SEU-FRONT.vercel.app
OPEN_FINANCE_REDIRECT_URI=https://SEU-FRONT.vercel.app/api/open-finance/callback
SANDBOX_BANK_AUTHORISATION_URL=https://SEU-FRONT.vercel.app/sandbox/authorize

REGISTRATION_CONSENT_POLICY_VERSION=2026-10-01
TIME_ZONE=America/Sao_Paulo
LOG_LEVEL=info

# DEMONSTRATION ONLY. Any signed-in person can book movements on anybody's
# account by id. Set to disabled if real people will register.
SANDBOX_BANK_LEDGER_WRITES=enabled

# Every request arrives from Vercel's servers, so these per-IP windows are shared
# by many users. Raised so a demonstration does not run out.
REGISTRATION_ATTEMPTS_PER_HOUR=200
REGISTRATION_SUCCESSES_PER_HOUR=50
SIGN_IN_ATTEMPTS_PER_QUARTER_HOUR=300
PASSWORD_RESET_ATTEMPTS_PER_HOUR=50
