// The schema is derived from the domain, never the reverse: model the aggregate first,
// then write the migration that stores it. Tables are prefixed by bounded context so
// module ownership is visible in psql, and no foreign key ever crosses a context.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// identity — users, credentials, sessions, "who is asking"
// ---------------------------------------------------------------------------

enum RegistrationConsentScope {
  NAME_AND_EMAIL

  @@map("identity_registration_consent_scope")
}

model User {
  id                      String                   @id @db.Uuid
  displayName             String                   @map("display_name") @db.VarChar(80)
  email                   String                   @unique @db.VarChar(254)
  passwordHash            String                   @map("password_hash")
  registeredAt            DateTime                 @map("registered_at") @db.Timestamptz(3)
  consentAcceptedAt       DateTime                 @map("consent_accepted_at") @db.Timestamptz(3)
  consentPolicyVersion    String                   @map("consent_policy_version") @db.VarChar(32)
  consentScope            RegistrationConsentScope @map("consent_scope")
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]

  @@map("identity_users")
}

model Session {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  issuedAt   DateTime  @map("issued_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("identity_sessions")
}

/// The attempt window for one address. It is a delay, never a lockout: there is
/// no "locked" column here and there never will be one. The address is stored as
/// a fingerprint, so this table cannot be read as a list of the people who tried
/// to sign in.
model SignInThrottle {
  identifierHash String    @id @map("identifier_hash") @db.VarChar(64)
  failureCount   Int       @default(0) @map("failure_count")
  firstFailureAt DateTime? @map("first_failure_at") @db.Timestamptz(3)
  blockedUntil   DateTime? @map("blocked_until") @db.Timestamptz(3)

  @@map("identity_sign_in_attempts")
}

/// Single use, 60-minute TTL, stored hashed: a database dump must not yield
/// usable reset links.
model PasswordResetToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  issuedAt   DateTime  @map("issued_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("identity_password_reset_tokens")
}

// ---------------------------------------------------------------------------
// open-finance — consent lifecycle (DataRecipient side)
//
// Only the read side of Consent exists today: `identity` needs to answer
// "has this user authorised an Open Finance consent?" on every authenticated
// page, and registration's contract is that a brand-new user answers `false`.
// The Consent aggregate and its write path arrive with the Open Finance feature.
// ---------------------------------------------------------------------------

enum ConsentStatus {
  AWAITING_AUTHORISATION
  AUTHORISED
  REJECTED
  REVOKED
  EXPIRED

  @@map("open_finance_consent_status")
}

model Consent {
  id           String             @id @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  status       ConsentStatus
  createdAt    DateTime           @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime           @map("expires_at") @db.Timestamptz(3)
  /// Null until the first ingestion finishes: that is what SYNCING means.
  lastSyncedAt DateTime?          @map("last_synced_at") @db.Timestamptz(3)
  accounts     ConnectedAccount[]

  @@index([userId, status])
  @@map("open_finance_consents")
}

enum AccountKind {
  CHECKING
  CREDIT_CARD

  @@map("open_finance_account_kind")
}

enum TransactionCategory {
  BETS
  GROCERIES
  DINING
  TRANSPORT
  HOUSING
  HEALTH
  SUBSCRIPTIONS
  SHOPPING
  INCOME
  TRANSFER
  OTHER

  @@map("open_finance_transaction_category")
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  DIRECT_DEBIT
  TRANSFER
  BOLETO

  @@map("open_finance_payment_method")
}

enum TransactionStatus {
  SETTLED
  PENDING

  @@map("open_finance_transaction_status")
}

/// Only the last four digits ever exist here: the full number and the check
/// digit are dropped at ingestion, so there is nothing to leak.
model ConnectedAccount {
  id           String        @id @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  consentId    String        @map("consent_id") @db.Uuid
  institution  String        @db.VarChar(120)
  shortName    String        @map("short_name") @db.VarChar(60)
  product      String        @db.VarChar(60)
  maskedNumber String        @map("masked_number") @db.VarChar(16)
  kind         AccountKind
  connectedAt  DateTime      @map("connected_at") @db.Timestamptz(3)
  consent      Consent       @relation(fields: [consentId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([consentId])
  @@map("open_finance_connected_accounts")
}

/// The amount is signed integer cents: negative leaves the account, positive
/// arrives. There is no `description` column — the raw statement line lives in
/// `bet-detection`, which is the only context allowed to read it.
///
/// The three `bet_*` columns are a **projection** of `bet-detection`'s verdict,
/// kept current by subscribing to its events. They exist so the statement can
/// be filtered and totalled in one query instead of joining across contexts.
model Transaction {
  id            String              @id @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  accountId     String              @map("account_id") @db.Uuid
  occurredAt    DateTime            @map("occurred_at") @db.Timestamptz(3)
  amountInCents Int                 @map("amount_in_cents")
  counterparty  String              @db.VarChar(140)
  category      TransactionCategory
  method        PaymentMethod
  status        TransactionStatus
  ingestedAt    DateTime            @map("ingested_at") @db.Timestamptz(3)
  betMatchedBy  DetectionReason?    @map("bet_matched_by")
  betConfidence DetectionConfidence? @map("bet_confidence")
  betSource     ClassificationSource? @map("bet_source")
  overriddenAt  DateTime?           @map("overridden_at") @db.Timestamptz(3)
  account       ConnectedAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([userId, accountId])
  @@map("open_finance_transactions")
}

// ---------------------------------------------------------------------------
// bet-detection — classifying transactions as gambling
// ---------------------------------------------------------------------------

enum DetectionReason {
  GAMBLING_MCC
  LICENSED_CNPJ
  DESCRIPTION_KEYWORD

  @@map("bet_detection_reason")
}

enum DetectionConfidence {
  HIGH
  MEDIUM
  LOW

  @@map("bet_detection_confidence")
}

enum ClassificationSource {
  POLICY
  USER_OVERRIDE

  @@map("bet_detection_source")
}

enum OverrideVerdict {
  NOT_A_BET

  @@map("bet_detection_override_verdict")
}

/// A betting operator, by registration number. Data rather than code, so a
/// correction undone tomorrow is judged by tomorrow's registry.
model Bookmaker {
  id           String   @id @db.Uuid
  tradeName    String   @map("trade_name") @db.VarChar(120)
  document     String   @unique @db.VarChar(14)
  registeredAt DateTime @map("registered_at") @db.Timestamptz(3)

  @@map("bet_detection_bookmakers")
}

/// Everything this context knows about one transaction: the signals the
/// policies may read, the chain's verdict, and the person's correction.
///
/// `description` is the raw statement line. It is here and nowhere else: not in
/// a response, not in an event payload, not in a log line.
model TransactionClassification {
  transactionId        String                @id @map("transaction_id") @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  mcc                  Int?
  counterpartyDocument String?               @map("counterparty_document") @db.VarChar(14)
  description          String                @default("")
  matchedBy            DetectionReason?      @map("matched_by")
  confidence           DetectionConfidence?
  classifiedAt         DateTime              @map("classified_at") @db.Timestamptz(3)
  overrideVerdict      OverrideVerdict?      @map("override_verdict")
  overrideReason       String?               @map("override_reason") @db.VarChar(280)
  overriddenAt         DateTime?             @map("overridden_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("bet_detection_classifications")
}

// ---------------------------------------------------------------------------
// gamification — streaks, badges, savings goals
//
// Both aggregates are created empty when `UserRegistered` arrives, so no screen
// has to tell "no aggregate at all" from "empty aggregate".
// ---------------------------------------------------------------------------

model Streak {
  id          String   @id @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  currentDays Int      @default(0) @map("current_days")
  longestDays Int      @default(0) @map("longest_days")
  startedAt   DateTime @map("started_at") @db.Timestamptz(3)
  version     Int      @default(0)

  @@map("gamification_streaks")
}

model BadgeCollection {
  id        String   @id @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  version   Int      @default(0)
  badges    Badge[]

  @@map("gamification_badge_collections")
}

model Badge {
  id           String          @id @db.Uuid
  collectionId String          @map("collection_id") @db.Uuid
  kind         String          @db.VarChar(64)
  awardedAt    DateTime        @map("awarded_at") @db.Timestamptz(3)
  collection   BadgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, kind])
  @@index([collectionId])
  @@map("gamification_badges")
}

// ---------------------------------------------------------------------------
// notifications — delivery of nudges and achievements
//
// The inbox exists from registration so the first real nudge has somewhere to
// land even when no browser is connected. Registration itself pushes nothing.
// ---------------------------------------------------------------------------

model Inbox {
  id        String   @id @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  @@map("notifications_inboxes")
}
