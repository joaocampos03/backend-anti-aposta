// The schema is derived from the domain, never the reverse: model the aggregate first,
// then write the migration that stores it. Tables are prefixed by bounded context so
// module ownership is visible in psql, and no foreign key ever crosses a context.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// identity — users, credentials, sessions, "who is asking"
// ---------------------------------------------------------------------------

enum RegistrationConsentScope {
  NAME_AND_EMAIL

  @@map("identity_registration_consent_scope")
}

model User {
  id                      String                   @id @db.Uuid
  displayName             String                   @map("display_name") @db.VarChar(80)
  email                   String                   @unique @db.VarChar(254)
  passwordHash            String                   @map("password_hash")
  registeredAt            DateTime                 @map("registered_at") @db.Timestamptz(3)
  consentAcceptedAt       DateTime                 @map("consent_accepted_at") @db.Timestamptz(3)
  consentPolicyVersion    String                   @map("consent_policy_version") @db.VarChar(32)
  consentScope            RegistrationConsentScope @map("consent_scope")
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]

  @@map("identity_users")
}

model Session {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  issuedAt   DateTime  @map("issued_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("identity_sessions")
}

/// The attempt window for one address. It is a delay, never a lockout: there is
/// no "locked" column here and there never will be one. The address is stored as
/// a fingerprint, so this table cannot be read as a list of the people who tried
/// to sign in.
model SignInThrottle {
  identifierHash String    @id @map("identifier_hash") @db.VarChar(64)
  failureCount   Int       @default(0) @map("failure_count")
  firstFailureAt DateTime? @map("first_failure_at") @db.Timestamptz(3)
  blockedUntil   DateTime? @map("blocked_until") @db.Timestamptz(3)

  @@map("identity_sign_in_attempts")
}

/// Single use, 60-minute TTL, stored hashed: a database dump must not yield
/// usable reset links.
model PasswordResetToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  issuedAt   DateTime  @map("issued_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("identity_password_reset_tokens")
}

// ---------------------------------------------------------------------------
// open-finance — consent lifecycle (DataRecipient side)
//
// The consent is requested here, authorised at the DataHolder (`sandbox-bank`,
// reached over HTTP), and every transaction is ingested through it. Nothing in
// this section has a foreign key to the sandbox's tables: the two meet only in
// the Open Finance protocol.
// ---------------------------------------------------------------------------

enum ConsentStatus {
  AWAITING_AUTHORISATION
  AUTHORISED
  REJECTED
  REVOKED
  EXPIRED

  @@map("open_finance_consent_status")
}

model Consent {
  id                   String                @id @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  /// The consent's id at the DataHolder, which is what its tokens are bound to.
  externalConsentId    String                @map("external_consent_id") @db.VarChar(100)
  status               ConsentStatus
  createdAt            DateTime              @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime              @map("expires_at") @db.Timestamptz(3)
  /// Null until the first ingestion finishes: that is what SYNCING means.
  lastSyncedAt         DateTime?             @map("last_synced_at") @db.Timestamptz(3)
  accounts             ConnectedAccount[]
  authorisationRequest AuthorisationRequest?
  tokens               ConsentToken?

  @@index([userId, status])
  @@index([externalConsentId])
  @@map("open_finance_consents")
}

/// The OAuth round trip in flight: the `state` that must come back and the PKCE
/// verifier that proves this platform started it. Single use, minutes long, and
/// deleted once the callback arrives. Only the state's fingerprint is stored.
model AuthorisationRequest {
  consentId              String   @id @map("consent_id") @db.Uuid
  userId                 String   @map("user_id") @db.Uuid
  stateFingerprint       String   @map("state_fingerprint") @db.VarChar(64)
  codeVerifierCiphertext String   @map("code_verifier_ciphertext")
  createdAt              DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt              DateTime @map("expires_at") @db.Timestamptz(3)
  consent                Consent  @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("open_finance_authorisation_requests")
}

/// The DataHolder's tokens, AES-256-GCM encrypted. Decrypted only inside
/// `infrastructure/`, never logged, never returned.
model ConsentToken {
  consentId              String   @id @map("consent_id") @db.Uuid
  userId                 String   @map("user_id") @db.Uuid
  accessTokenCiphertext  String   @map("access_token_ciphertext")
  refreshTokenCiphertext String   @map("refresh_token_ciphertext")
  accessTokenExpiresAt   DateTime @map("access_token_expires_at") @db.Timestamptz(3)
  consent                Consent  @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("open_finance_consent_tokens")
}

enum AccountKind {
  CHECKING
  CREDIT_CARD

  @@map("open_finance_account_kind")
}

enum TransactionCategory {
  BETS
  GROCERIES
  DINING
  TRANSPORT
  HOUSING
  HEALTH
  SUBSCRIPTIONS
  SHOPPING
  INCOME
  TRANSFER
  OTHER

  @@map("open_finance_transaction_category")
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  DIRECT_DEBIT
  TRANSFER
  BOLETO

  @@map("open_finance_payment_method")
}

enum TransactionStatus {
  SETTLED
  PENDING

  @@map("open_finance_transaction_status")
}

/// Only the last four digits ever exist here: the full number and the check
/// digit are dropped at ingestion, so there is nothing to leak.
model ConnectedAccount {
  id           String        @id @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  consentId    String        @map("consent_id") @db.Uuid
  /// The DataHolder's account id: what a statement is requested by.
  externalId   String        @map("external_id") @db.VarChar(100)
  institution  String        @db.VarChar(120)
  shortName    String        @map("short_name") @db.VarChar(60)
  product      String        @db.VarChar(60)
  maskedNumber String        @map("masked_number") @db.VarChar(16)
  kind         AccountKind
  connectedAt  DateTime      @map("connected_at") @db.Timestamptz(3)
  consent      Consent       @relation(fields: [consentId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([consentId, externalId])
  @@index([userId])
  @@index([consentId])
  @@map("open_finance_connected_accounts")
}

/// The amount is signed integer cents: negative leaves the account, positive
/// arrives. There is no `description` column — the raw statement line lives in
/// `bet-detection`, which is the only context allowed to read it.
///
/// The three `bet_*` columns are a **projection** of `bet-detection`'s verdict,
/// kept current by subscribing to its events. They exist so the statement can
/// be filtered and totalled in one query instead of joining across contexts.
model Transaction {
  id            String              @id @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  accountId     String              @map("account_id") @db.Uuid
  /// The DataHolder's transaction id. Unique per account, which is what makes a
  /// second synchronisation of the same statement a no-op.
  externalId    String              @map("external_id") @db.VarChar(100)
  occurredAt    DateTime            @map("occurred_at") @db.Timestamptz(3)
  amountInCents Int                 @map("amount_in_cents")
  counterparty  String              @db.VarChar(140)
  category      TransactionCategory
  method        PaymentMethod
  status        TransactionStatus
  ingestedAt    DateTime            @map("ingested_at") @db.Timestamptz(3)
  betMatchedBy  DetectionReason?    @map("bet_matched_by")
  betConfidence DetectionConfidence? @map("bet_confidence")
  betSource     ClassificationSource? @map("bet_source")
  /// Which house the row belongs to, projected alongside the verdict so the
  /// bookmaker dialog filters the statement in one query. An opaque string, not
  /// a foreign key: the authoritative grouping lives in `bet-detection`.
  betBookmakerId String?            @map("bet_bookmaker_id") @db.VarChar(64)
  overriddenAt  DateTime?           @map("overridden_at") @db.Timestamptz(3)
  account       ConnectedAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([userId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([userId, accountId])
  @@index([userId, betBookmakerId, occurredAt(sort: Desc)], map: "open_finance_transactions_bookmaker_idx")
  @@map("open_finance_transactions")
}

// ---------------------------------------------------------------------------
// bet-detection — classifying transactions as gambling
// ---------------------------------------------------------------------------

enum DetectionReason {
  GAMBLING_MCC
  LICENSED_CNPJ
  DESCRIPTION_KEYWORD

  @@map("bet_detection_reason")
}

enum DetectionConfidence {
  HIGH
  MEDIUM
  LOW

  @@map("bet_detection_confidence")
}

enum ClassificationSource {
  POLICY
  USER_OVERRIDE

  @@map("bet_detection_source")
}

enum OverrideVerdict {
  NOT_A_BET

  @@map("bet_detection_override_verdict")
}

/// Whether a bookmaker grouping came from the registry or from a counterparty
/// name. No screen shows it: it is here so the paper can report how often an
/// unregistered grouping had to guess.
enum RegistryStatus {
  REGISTERED
  UNREGISTERED

  @@map("bet_detection_registry_status")
}

/// A betting operator, by registration number. Data rather than code, so a
/// correction undone tomorrow is judged by tomorrow's registry.
model Bookmaker {
  id           String   @id @db.Uuid
  tradeName    String   @map("trade_name") @db.VarChar(120)
  document     String   @unique @db.VarChar(14)
  registeredAt DateTime @map("registered_at") @db.Timestamptz(3)

  @@map("bet_detection_bookmakers")
}

/// Everything this context knows about one transaction: the signals the
/// policies may read, the chain's verdict, and the person's correction.
///
/// `description` is the raw statement line. It is here and nowhere else: not in
/// a response, not in an event payload, not in a log line.
model TransactionClassification {
  transactionId        String                @id @map("transaction_id") @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  mcc                  Int?
  counterpartyDocument String?               @map("counterparty_document") @db.VarChar(14)
  description          String                @default("")
  /// The normalised merchant name, not the statement line: it is what groups a
  /// house the registry has no entry for.
  counterparty         String                @default("") @db.VarChar(140)
  matchedBy            DetectionReason?      @map("matched_by")
  confidence           DetectionConfidence?
  /// The attribution, re-resolved every time the chain runs. `null` whenever the
  /// row is not a bet.
  bookmakerId          String?               @map("bookmaker_id") @db.VarChar(64)
  bookmakerName        String?               @map("bookmaker_name") @db.VarChar(140)
  registryStatus       RegistryStatus?       @map("registry_status")
  classifiedAt         DateTime              @map("classified_at") @db.Timestamptz(3)
  overrideVerdict      OverrideVerdict?      @map("override_verdict")
  overrideReason       String?               @map("override_reason") @db.VarChar(280)
  overriddenAt         DateTime?             @map("overridden_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([userId, bookmakerId], map: "bet_detection_classifications_bookmaker_idx")
  @@map("bet_detection_classifications")
}

// ---------------------------------------------------------------------------
// awareness — System 2 reframing and nudges
// ---------------------------------------------------------------------------

/// What a betting total is divided into, so an amount becomes something a
/// person recognises. Configuration rather than code, as the bookmaker registry
/// is: a price can be corrected without a deploy.
///
/// Every row carries where its price came from and when it was last looked at.
/// A stale figure makes the whole card look careless, and the screen labels
/// these as approximations because that is what they are.
model ReferenceItem {
  id            String   @id @db.VarChar(40)
  singular      String   @db.VarChar(60)
  plural        String   @db.VarChar(60)
  unitPriceInCents Int   @map("unit_price_in_cents")
  source        String   @db.VarChar(120)
  /// The São Paulo day the price was last reviewed, as a calendar key.
  reviewedAt    String   @map("reviewed_at") @db.VarChar(10)
  /// So an item can be retired without deleting the row that priced it.
  isActive      Boolean  @default(true) @map("is_active")

  @@map("awareness_reference_items")
}

// ---------------------------------------------------------------------------
// gamification — streaks, badges, savings goals
//
// Both aggregates are created empty when `UserRegistered` arrives, so no screen
// has to tell "no aggregate at all" from "empty aggregate".
// ---------------------------------------------------------------------------

model Streak {
  id          String   @id @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  currentDays Int      @default(0) @map("current_days")
  longestDays Int      @default(0) @map("longest_days")
  startedAt   DateTime @map("started_at") @db.Timestamptz(3)
  version     Int      @default(0)

  @@map("gamification_streaks")
}

model BadgeCollection {
  id        String   @id @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  version   Int      @default(0)
  badges    Badge[]

  @@map("gamification_badge_collections")
}

model Badge {
  id           String          @id @db.Uuid
  collectionId String          @map("collection_id") @db.Uuid
  kind         String          @db.VarChar(64)
  awardedAt    DateTime        @map("awarded_at") @db.Timestamptz(3)
  collection   BadgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, kind])
  @@index([collectionId])
  @@map("gamification_badges")
}

// Savings goals: self-reported. The balance is never stored — it is summed from
// the movements, which are append-only.

enum SavingsGoalPurpose {
  EMERGENCY_FUND
  DEBT_PAYOFF
  HOME
  EDUCATION
  TRAVEL
  VEHICLE
  HEALTH
  OTHER

  @@map("gamification_goal_purpose")
}

enum GoalMovementDirection {
  DEPOSIT
  WITHDRAWAL

  @@map("gamification_movement_direction")
}

/// `reached_at` is null until the balance first reaches the target, and is never cleared after.
model SavingsGoal {
  id            String             @id @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  title         String             @db.VarChar(60)
  purpose       SavingsGoalPurpose
  targetInCents Int                @map("target_in_cents")
  createdAt     DateTime           @map("created_at") @db.Timestamptz(3)
  reachedAt     DateTime?          @map("reached_at") @db.Timestamptz(3)
  version       Int                @default(0)
  movements     GoalMovement[]

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("gamification_savings_goals")
}

/// `idempotency_key` is null when the client sent none with the request.
model GoalMovement {
  id             String                @id @db.Uuid
  goalId         String                @map("goal_id") @db.Uuid
  direction      GoalMovementDirection
  amountInCents  Int                   @map("amount_in_cents")
  occurredAt     DateTime              @map("occurred_at") @db.Timestamptz(3)
  reachedTarget  Boolean               @default(false) @map("reached_target")
  idempotencyKey String?               @map("idempotency_key") @db.VarChar(64)
  goal           SavingsGoal           @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, idempotencyKey])
  @@index([goalId, occurredAt(sort: Desc), id(sort: Desc)])
  @@map("gamification_goal_movements")
}

// The betting ceiling: one per user, created on the first choice, and every
// value it has had — closed months stay measured against their own ceiling.

model BettingCeiling {
  id        String        @id @db.Uuid
  userId    String        @unique @map("user_id") @db.Uuid
  createdAt DateTime      @map("created_at") @db.Timestamptz(3)
  version   Int           @default(0)
  terms     CeilingTerm[]

  @@map("gamification_betting_ceilings")
}

/// `destination` is null when the user said nothing about where the money should go.
model CeilingTerm {
  id            String         @id @db.Uuid
  ceilingId     String         @map("ceiling_id") @db.Uuid
  amountInCents Int            @map("amount_in_cents")
  destination   String?        @db.VarChar(60)
  /// A São Paulo month, `YYYY-MM`.
  effectiveFrom String         @map("effective_from") @db.Char(7)
  setAt         DateTime       @map("set_at") @db.Timestamptz(3)
  ceiling       BettingCeiling @relation(fields: [ceilingId], references: [id], onDelete: Cascade)

  @@unique([ceilingId, effectiveFrom])
  @@map("gamification_ceiling_terms")
}

// ---------------------------------------------------------------------------
// notifications — delivery of nudges and achievements
//
// The inbox exists from registration so the first real nudge has somewhere to
// land even when no browser is connected. Registration itself pushes nothing.
// ---------------------------------------------------------------------------

model Inbox {
  id        String   @id @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  @@map("notifications_inboxes")
}

enum NotificationKind {
  AWARENESS_NUDGE
  BADGE_AWARDED
  STREAK_BROKEN
  GOAL_REACHED
  TRANSACTIONS_INGESTED

  @@map("notifications_kind")
}

/// One thing pushed to one person. The inbox is the source of truth and the
/// stream an optimisation: a row exists before any browser sees it, and its
/// UUID v7 id is what a reconnecting stream resumes after. `content` holds the
/// kind's display fields — amounts in cents and short text, never a raw
/// statement line or a token.
model Notification {
  id          String           @id @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  kind        NotificationKind
  content     Json
  createdAt   DateTime         @map("created_at") @db.Timestamptz(3)

  @@index([recipientId, id])
  @@map("notifications_notifications")
}

// ---------------------------------------------------------------------------
// sandbox-bank — the simulated DataHolder (instituição transmissora)
//
// A foreign system that happens to share the process and the database. Nothing
// outside `sandbox-bank` reads these tables: `open-finance` reaches this data
// only through the Open Finance HTTP surface. `customer_id` is the platform
// user standing in for the bank's own login, kept as a bare uuid.
// ---------------------------------------------------------------------------

enum SandboxAccountType {
  CONTA_DEPOSITO_A_VISTA
  CARTAO_CREDITO

  @@map("sandbox_bank_account_type")
}

enum SandboxEntryType {
  PIX
  TED
  BOLETO
  CONVENIO_ARRECADACAO
  CARTAO
  FOLHA_PAGAMENTO
  TRANSFERENCIA_MESMA_INSTITUICAO

  @@map("sandbox_bank_entry_type")
}

enum SandboxEntryStatus {
  TRANSACAO_EFETIVADA
  LANCAMENTO_FUTURO

  @@map("sandbox_bank_entry_status")
}

enum SandboxConsentStatus {
  AWAITING_AUTHORISATION
  AUTHORISED
  REJECTED
  REVOKED

  @@map("sandbox_bank_consent_status")
}

enum SandboxPermission {
  ACCOUNTS_READ
  ACCOUNTS_TRANSACTIONS_READ
  RESOURCES_READ

  @@map("sandbox_bank_permission")
}

enum SandboxTokenKind {
  ACCESS
  REFRESH

  @@map("sandbox_bank_token_kind")
}

enum SandboxTokenScope {
  CONSENTS
  ACCOUNTS

  @@map("sandbox_bank_token_scope")
}

/// The full number and check digit live here, as they would at a bank. The
/// DataRecipient masks them the moment they arrive.
model SandboxBankAccount {
  id          String               @id @db.Uuid
  customerId  String               @map("customer_id") @db.Uuid
  type        SandboxAccountType
  brandName   String               @map("brand_name") @db.VarChar(80)
  companyCnpj String               @map("company_cnpj") @db.VarChar(14)
  compeCode   String               @map("compe_code") @db.VarChar(3)
  branchCode  String               @map("branch_code") @db.VarChar(4)
  number      String               @db.VarChar(20)
  checkDigit  String               @map("check_digit") @db.VarChar(1)
  openedAt    DateTime             @map("opened_at") @db.Timestamptz(3)
  entries     SandboxLedgerEntry[]

  @@index([customerId])
  @@map("sandbox_bank_accounts")
}

/// Signed integer cents: negative leaves the account. `transaction_name` is the
/// raw statement line, exactly as a bank would print it.
model SandboxLedgerEntry {
  id                   String             @id @db.Uuid
  accountId            String             @map("account_id") @db.Uuid
  customerId           String             @map("customer_id") @db.Uuid
  bookedAt             DateTime           @map("booked_at") @db.Timestamptz(3)
  amountInCents        Int                @map("amount_in_cents")
  transactionName      String             @map("transaction_name") @db.VarChar(140)
  type                 SandboxEntryType
  status               SandboxEntryStatus
  merchantCategoryCode Int?               @map("merchant_category_code")
  payeeDocument        String?            @map("payee_document") @db.VarChar(14)
  account              SandboxBankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, bookedAt(sort: Desc), id(sort: Desc)])
  @@map("sandbox_bank_ledger_entries")
}

/// The bank's side of the consent. `customer_id` is null until somebody
/// authorises it: before that, the bank does not know whose it is.
model SandboxConsent {
  id              String               @id @db.Uuid
  clientId        String               @map("client_id") @db.VarChar(64)
  status          SandboxConsentStatus
  permissions     SandboxPermission[]
  customerId      String?              @map("customer_id") @db.Uuid
  accountIds      String[]             @map("account_ids") @db.Uuid
  createdAt       DateTime             @map("created_at") @db.Timestamptz(3)
  statusUpdatedAt DateTime             @map("status_updated_at") @db.Timestamptz(3)
  expiresAt       DateTime             @map("expires_at") @db.Timestamptz(3)

  @@index([clientId])
  @@index([accountIds], type: Gin)
  @@map("sandbox_bank_consents")
}

/// Single use, minutes long, bound to the client, the redirect and the PKCE
/// challenge. Only the code's fingerprint is stored.
model SandboxAuthorisationCode {
  id              String    @id @db.Uuid
  codeFingerprint String    @unique @map("code_fingerprint") @db.VarChar(64)
  consentId       String    @map("consent_id") @db.Uuid
  clientId        String    @map("client_id") @db.VarChar(64)
  redirectUri     String    @map("redirect_uri") @db.VarChar(500)
  codeChallenge   String    @map("code_challenge") @db.VarChar(128)
  issuedAt        DateTime  @map("issued_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Null until redeemed; a second redemption is refused.
  redeemedAt      DateTime? @map("redeemed_at") @db.Timestamptz(3)

  @@index([consentId])
  @@map("sandbox_bank_authorisation_codes")
}

/// Access and refresh tokens, by fingerprint. `consent_id` is null for a
/// client-credentials token, which belongs to no consent.
model SandboxIssuedToken {
  id               String            @id @db.Uuid
  tokenFingerprint String            @unique @map("token_fingerprint") @db.VarChar(64)
  kind             SandboxTokenKind
  scope            SandboxTokenScope
  clientId         String            @map("client_id") @db.VarChar(64)
  consentId        String?           @map("consent_id") @db.Uuid
  issuedAt         DateTime          @map("issued_at") @db.Timestamptz(3)
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(3)
  /// Null while usable. Set on rotation and on the consent's revocation.
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz(3)

  @@index([consentId])
  @@map("sandbox_bank_issued_tokens")
}
