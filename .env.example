# Copy to .env and adjust. Every variable here is validated once at boot by the
# Zod schema in src/shared/infrastructure/env.ts, which is the only file in the
# repository allowed to read process.env. A missing or malformed value fails at
# startup, not at 2 a.m. inside a route handler.
#
# This file is committed on purpose and must never hold a real secret. When the
# first one arrives — SMTP credentials for the password-reset e-mail, the
# AES-256-GCM key for Open Finance tokens — it goes in .env (ignored) and only a
# placeholder goes here.

NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# The local container from docker-compose.yml. Throwaway credentials that only
# reach a database on this machine.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/antiapostadb?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5434/antiapostadb?schema=public"

# CORS allows exactly this origin, with credentials. Never a wildcard.
FRONTEND_ORIGIN=http://localhost:3000

# Which hop may report the browser's address through X-Forwarded-For (Express
# "trust proxy" syntax, or "none"). Every browser request arrives through the
# Next.js server, so without this the per-IP limits below would count all users
# as one. Locally the Next.js server connects over loopback; in production, name
# its address and nothing wider — a trusted hop can claim any address.
TRUST_PROXY=loopback

# Sessions last 14 days and slide: one used with fewer than
# SESSION_RENEW_WITHIN_DAYS left is extended to a fresh 14.
SESSION_TTL_IN_DAYS=14
SESSION_RENEW_WITHIN_DAYS=7

# Stamped on every RegistrationConsent. A placeholder until a real
# terms-of-use document exists.
REGISTRATION_CONSENT_POLICY_VERSION=2026-10-01

# Day and month boundaries. Never UTC: a bet at 23:30 in Sao Paulo belongs to
# that day, and gamification counts streak days against this.
TIME_ZONE=America/Sao_Paulo

# Per-IP rate limits. These delay a caller; they never lock an account.
# The window that protects one account from password guessing is SignInThrottle,
# in the domain, and it is not configurable here on purpose: it is a product
# rule rather than a tuning parameter.
REGISTRATION_ATTEMPTS_PER_HOUR=20
REGISTRATION_SUCCESSES_PER_HOUR=5
SIGN_IN_ATTEMPTS_PER_QUARTER_HOUR=50
PASSWORD_RESET_ATTEMPTS_PER_HOUR=10

# Cloudflare Turnstile, checked on registration only. Leave it unset locally:
# outside Vercel production it falls back to Cloudflare's always-passing test
# secret. In Vercel production (VERCEL_ENV=production, set by Vercel) it is
# required and a test key is refused at boot. The real secret lives in the
# Vercel project settings, never here.
# TURNSTILE_SECRET_KEY=
CLASSIFICATION_OVERRIDES_PER_HOUR=30
# Starting, completing and synchronising an Open Finance consent; each calls
# the DataHolder.
CONSENT_COMMANDS_PER_HOUR=60
# Creating savings goals, recording movements and setting the betting ceiling.
GOAL_COMMANDS_PER_HOUR=120

# --- Open Finance: this platform as the DataRecipient ----------------------
# Both values below are SECRETS: generate your own and put them in .env only.
# The placeholders here fail validation on purpose, so a copied .env.example
# never boots with a key somebody else knows.
#
# AES-256-GCM key for the DataHolder's tokens at rest: openssl rand -base64 32
OPEN_FINANCE_TOKEN_KEY=generate-with-openssl-rand-base64-32
# The client secret this platform and the sandbox bank share (16+ characters):
# openssl rand -base64 24
OPEN_FINANCE_CLIENT_SECRET=replace-me
OPEN_FINANCE_CLIENT_ID=anti-aposta
# The frontend route that receives the bank's redirect and relays it here.
OPEN_FINANCE_REDIRECT_URI=http://localhost:3000/api/open-finance/callback
# Where the bank says "this consent's resources changed" so the platform
# synchronises at once. It only prompts a read; it carries no data.
OPEN_FINANCE_NOTICE_URI=http://localhost:3333/api/v1/data-holder-notices

# --- sandbox-bank: the simulated DataHolder --------------------------------
# Reached over HTTP even though it runs in this process: that is the point.
SANDBOX_BANK_BASE_URL=http://localhost:3333/sandbox/open-finance/v2
# The bank's authorisation screen, rendered by the frontend.
SANDBOX_BANK_AUTHORISATION_URL=http://localhost:3000/sandbox/authorize
# Lets a signed-in person book fake movements at the sandbox. Forced off when
# NODE_ENV=production, whatever this says.
SANDBOX_BANK_LEDGER_WRITES=enabled
SANDBOX_BANK_LEDGER_ENTRIES_PER_HOUR=120
# The demonstration console's sends to a person by id. Mounted only where
# SANDBOX_BANK_LEDGER_WRITES is on.
DEMO_NOTIFICATIONS_PER_HOUR=120
